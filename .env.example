# --- Server ---
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-side only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
# Only needed for `bun run db:migrate` (direct Postgres connection, not the REST API).
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI).
SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# --- Azure Document Intelligence ---
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=your-azure-key
AZURE_DOCUMENT_INTELLIGENCE_MODEL_ID=prebuilt-invoice

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=50

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your-secret-key
# Stripe Dashboard -> Developers -> Webhooks -> select your endpoint -> Signing secret.
# When testing locally with `stripe listen`, use the secret it prints instead.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
# Price IDs (not Product IDs) for the recurring "basic"/"pro" plans, from
# Stripe Dashboard -> Product catalog.
STRIPE_PRICE_ID_BASIC=price_your-basic-price-id
STRIPE_PRICE_ID_PRO=price_your-pro-price-id
