# Docker only reads .dockerignore from the build context root - since
# apps/backend/Dockerfile now needs to see the workspace root (pnpm-lock.yaml,
# pnpm-workspace.yaml, every workspace member's package.json), the build
# context is this whole monorepo root, not apps/backend/ alone. This file
# lives here for that reason, not because backend's own excludes changed.

# --- Version control & CI ---
.git
.github

# --- Environment & secrets ---
# Never baked into the image; real config is injected at `docker run`
# time via -e/--env-file or an orchestrator's secret manager.
.env
.env.*
!.env.example

# --- Dependencies ---
# Installed fresh inside the image at each relevant build stage.
node_modules
.pnpm-store

# --- Coverage & logs ---
coverage
*.log
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*
.pnpm-debug.log*

# --- Build outputs ---
dist
build
.turbo
.next

# --- OS & editor junk ---
.DS_Store
.vscode
.idea
*.swp

# NOTE: apps/backend/**/*.test.ts files are deliberately NOT excluded
# here, even though that's commonly recommended for a Dockerfile's build
# context. The Dockerfile runs `bun run test` as a build-time gate -
# excluding test files from the context would leave vitest with nothing to
# run, and the gate would silently "pass" without actually checking
# anything. Test files never reach the final runtime image anyway: the
# `test` stage deletes them immediately after running, before the
# `release` stage copies `src/` from it.
