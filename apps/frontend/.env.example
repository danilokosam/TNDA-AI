# --- Backend API ---
# The TNDA-AI backend (Bun + ElysiaJS). Server-only — every call to it goes
# through this app's own Route Handlers / Server Components, never directly
# from the browser.
BACKEND_URL=http://localhost:3000

# --- Supabase ---
# Same project the backend uses. Server-only, and session/auth plumbing
# only (@supabase/ssr's cookie/refresh lifecycle, set up after the
# backend's own signup/login) — this app has no direct-Supabase data access
# path of its own; every list, stat, and document read goes through a real
# backend endpoint (see ARCHITECTURE.md). Never exposed to the browser —
# nothing in this file is NEXT_PUBLIC_-prefixed on purpose.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
