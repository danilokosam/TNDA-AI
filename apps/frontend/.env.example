# --- Backend API ---
# The TNDA-AI backend (Bun + ElysiaJS). Server-only — every call to it goes
# through this app's own Route Handlers / Server Components, never directly
# from the browser.
BACKEND_URL=http://localhost:3000

# --- Supabase ---
# Same project the backend uses. Server-only here too: used for (1) the
# @supabase/ssr session/cookie/refresh lifecycle set up after the backend's
# own signup/login, and (2) RLS-scoped direct reads (document history +
# stats) that the backend has no list endpoint for. Never exposed to the
# browser — nothing in this file is NEXT_PUBLIC_-prefixed on purpose.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
