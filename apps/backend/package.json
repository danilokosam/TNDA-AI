{
  "name": "@tnda-ai/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "worker:dev": "bun run --watch src/worker/index.ts",
    "worker:start": "bun run src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "bun run scripts/db-migrate.ts",
    "db:push": "supabase db push"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.1",
    "@elysiajs/swagger": "^1.1.6",
    "@supabase/supabase-js": "^2.45.4",
    "elysia": "^1.1.26",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2",
    "file-type": "^19.6.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "stripe": "^22.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tnda-ai/config": "workspace:*",
    "bun-types": "1.3.14",
    "eslint": "^10.8.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
